{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chth-gym",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "chth.space",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jesm-db",
      "database_id": "0f35ba89-954c-4203-a452-c6d01cf859cc",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "8ef0d72f24f74b0eae3e182ecb5ed2e5"
    }
  ],
  // The CHTH hub Worker (same Cloudflare account): sign-ups, workouts, tagged visits and errors
  // are reported through it. Set the shared secret with `wrangler secret put HUB_SECRET`.
  "services": [
    { "binding": "HUB", "service": "chth-hub" }
  ],
  "vars": {
    "APP_NAME": "CHTH Gym",
    "APP_ENV": "production",
    "REDIRECT_URI": "https://chth.space/api/auth/google/callback"
  }
}
