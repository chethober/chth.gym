{
  "name": "chth-gym",
  "version": "1.0.0",
  "description": "Cloud-based workout tracker, smart routine planner, and fitness analytics platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply chth-gym-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply chth-gym-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
